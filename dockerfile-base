ARG MINICONDA_VERSION=26.5.3
FROM anaconda/miniconda:${MINICONDA_VERSION} AS dependencies

# Keep compatibility with tools and scripts that expect Conda at /opt/conda.
RUN if [ ! -e /opt/conda ]; then ln -s "$(conda info --base)" /opt/conda; fi

ENV PYTHON_VERSION=3.11 \
    SNAKEMAKE_VERSION=9.7.1 \
    APPTAINER_VERSION=1.5.3

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gzip \
        libgomp1 \
        p7zip-full \
        parallel \
        pigz \
        rsync \
        tabix \
        vim \
        wget \
        xkcdpass \
        zlib1g \
        zlib1g-dev && \
    test -s /etc/ssl/certs/ca-certificates.crt && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN conda config --system --remove-key channels && \
    conda config --system --add channels defaults && \
    conda config --system --add channels bioconda && \
    conda config --system --add channels conda-forge && \
    conda config --system --set channel_priority strict && \
    conda config --system --set plugins.auto_accept_tos yes

RUN conda install --yes \
        python=${PYTHON_VERSION} \
        pip \
        pandas \
        xlrd \
        ea-utils \
        configparser \
        requests \
        illumina-interop \
        gh \
        openpyxl \
        numpy \
        snakemake=${SNAKEMAKE_VERSION} \
        apptainer=${APPTAINER_VERSION} && \
    conda clean --all --yes

RUN conda --version && \
    python --version && \
    snakemake --version && \
    apptainer --version && \
    singularity --version && \
    interop_summary | grep Version && \
    interop_index-summary | grep Version

# Allow shared loop devices for Apptainer/Singularity.
RUN sed -i -e 's/shared loop devices = no/shared loop devices = yes/g' /opt/conda/etc/apptainer/apptainer.conf

FROM dependencies AS base

WORKDIR /opt

RUN mkdir images
COPY files/ntnu.png images/
COPY files/logo_ntnu.png /opt/images/

RUN mkdir /bfq
WORKDIR /bfq
RUN mkdir output seq_share data log

WORKDIR /opt

#FIX for qiime2 cli: need access to cache files in /home of q2 image
RUN chmod -R a+w /home

ENV TMPDIR=/bfq-tmp
ENV EXT_DIR=/bfq-ext
ENV GCF_EXT=$EXT_DIR
ENV SINGULARITY_BINDPATH=/mnt,/opt/gcf-workflows,/bfq-tmp,/bfq-ext,/home,/instruments,/import-kista
ENV SINGULARITY_CACHEDIR=$TMPDIR/singularity/
ENV SINGULARITY_TMPDIR=$SINGULARITY_CACHEDIR/tmp
ENV SINGULARITY_LOCALCACHEDIR=$SINGULARITY_CACHEDIR/tmp/
ENV SINGULARITY_PULLFOLDER=$SINGULARITY_CACHEDIR
ENV SINGULARITY_WRITABLE_TMPFS=true
ENV APPTAINER_BINDPATH=$SINGULARITY_BINDPATH
ENV APPTAINER_CACHEDIR=$SINGULARITY_CACHEDIR
ENV APPTAINER_TMPDIR=$SINGULARITY_TMPDIR
ENV APPTAINER_LOCALCACHEDIR=$SINGULARITY_LOCALCACHEDIR
ENV APPTAINER_PULLFOLDER=$SINGULARITY_PULLFOLDER
ENV APPTAINER_WRITABLE_TMPFS=$SINGULARITY_WRITABLE_TMPFS
ENV GCF_SECRET=/secrets/gcf_secrets.yaml

#ENV FORCE_BCL2FASTQ=True
