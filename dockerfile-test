ARG BASE_IMAGE=gcfntnu/bfq:base-260925
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG BFQ_REVISION=unknown
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.revision="${BFQ_REVISION}"

ENV BFQ_ENV=test

ARG GCF_TOOLS_BRANCH=bfq-dev
ARG GCF_TOOLS_REV=${GCF_TOOLS_BRANCH}
# BFQ and its configmaker subprocess must resolve the same validation API.
RUN /opt/conda/bin/python -m pip install --upgrade "https://github.com/gcfntnu/gcf-tools/archive/${GCF_TOOLS_REV}.zip" && \
    /opt/conda/bin/python -c "from configmaker.validation import VALIDATION_API_VERSION; assert VALIDATION_API_VERSION == 1"

ARG GCF_WORKFLOWS_BRANCH=bfq-dev
ARG GCF_WORKFLOWS_REV=${GCF_WORKFLOWS_BRANCH}
# The build script resolves branch heads once, before Docker builds. Immutable
# revisions invalidate its cache without rate-limited GitHub API ADD requests.
RUN git init /opt/gcf-workflows && \
    cd /opt/gcf-workflows && \
    git remote add origin https://github.com/gcfntnu/gcf-workflows.git && \
    git fetch --depth 1 origin "${GCF_WORKFLOWS_REV}" && \
    git checkout -B "${GCF_WORKFLOWS_BRANCH}" FETCH_HEAD
LABEL org.gcf.gcf-tools.branch="${GCF_TOOLS_BRANCH}" \
      org.gcf.gcf-tools.revision="${GCF_TOOLS_REV}" \
      org.gcf.gcf-workflows.branch="${GCF_WORKFLOWS_BRANCH}" \
      org.gcf.gcf-workflows.revision="${GCF_WORKFLOWS_REV}"

COPY pyproject.toml /opt/gcf-bfq/pyproject.toml
COPY bcl2fastq_pipeline /opt/gcf-bfq/bcl2fastq_pipeline
# Check BFQ imports; the shared Conda image also contains independently managed tools.
RUN /opt/conda/bin/python -m pip install /opt/gcf-bfq && \
    /opt/conda/bin/python -c "import bcl2fastq_pipeline.cli"

WORKDIR /opt
CMD ["bfq"]
